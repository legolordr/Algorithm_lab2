<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Algorithm_lab2.Controls"
             x:Class="Algorithm_lab2.Views.MazeView">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,*" Margin="24,20,24,24">
        <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,20">
            <TextBlock Classes="h1" Text="Генератор лабиринта" />
            <TextBlock Classes="subtitle"
                       Text="Рекурсивный поиск с возвратом (backtracker): из текущей клетки идём в случайную непосещённую соседнюю, а в тупике возвращаемся назад по стеку вызовов." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Margin="0,0,14,0">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="ПАРАМЕТРЫ" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Размер сетки" />
                            <NumericUpDown x:Name="SizeInput" Minimum="5" Maximum="40" Value="20"
                                           Increment="1" FormatString="0" AutomationProperties.Name="Размер сетки" />
                            <TextBlock x:Name="SizeInfoText" Classes="hint" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Seed" />
                            <NumericUpDown x:Name="SeedInput" Minimum="-1" Maximum="999999999" Value="-1"
                                           Increment="1" FormatString="0" AutomationProperties.Name="Seed" />
                            <TextBlock Classes="hint" Text="−1 — случайный лабиринт при каждой генерации" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <controls:StatRow x:Name="SpeedRow" Label="Скорость" />
                            <Slider x:Name="SpeedSlider" Minimum="20" Maximum="5000" Value="300"
                                    AutomationProperties.Name="Скорость" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Button x:Name="PlayPauseButton" Content="Старт" Classes="accent wide" ToolTip.Tip="Пробел" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="ResetButton" Content="Сначала" Classes="wide" ToolTip.Tip="R" />
                            <Button Grid.Column="1" x:Name="RegenerateButton" Content="Новый" Classes="wide"
                                    ToolTip.Tip="N" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="СОСТОЯНИЕ" />
                        <controls:StatRow x:Name="ProgressRow" Label="Шаг" />
                        <ProgressBar x:Name="Progress" />
                        <TextBlock x:Name="StatusText" Classes="status" Foreground="{DynamicResource VizDoneBrush}"
                                   IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="СТАТИСТИКА" />
                        <controls:StatRow x:Name="CallsStat" Label="Рекурсивных вызовов" />
                        <controls:StatRow x:Name="DepthStat" Label="Макс. глубина рекурсии" />
                        <controls:StatRow x:Name="SeedStat" Label="Seed" />
                        <controls:StatRow x:Name="TimeStat" Label="Время расчёта" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Classes="canvas">
            <controls:MazeCanvas x:Name="Canvas" Margin="16" AutomationProperties.Name="Лабиринт" />
        </Border>
    </Grid>
</UserControl>
