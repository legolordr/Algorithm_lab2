<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Algorithm_lab2.Controls"
             x:Class="Algorithm_lab2.Views.MazeView">
    <Grid ColumnDefinitions="300,*">
        <ScrollViewer>
            <StackPanel Margin="8,12,16,12" Spacing="10">
                <TextBlock Text="Генератор лабиринта" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="Рекурсивный backtracker: заходит в случайную непосещённую соседнюю клетку, при тупике откатывается назад."
                           TextWrapping="Wrap" Opacity="0.75" />

                <TextBlock Text="Размер сетки" FontWeight="SemiBold" Margin="0,8,0,0" />
                <NumericUpDown x:Name="SizeInput" Minimum="5" Maximum="40" Value="20"
                               Increment="1" FormatString="0" />
                <TextBlock x:Name="SizeInfoText" Opacity="0.6" />

                <TextBlock Text="Seed (−1 = случайный)" FontWeight="SemiBold" Margin="0,4,0,0" />
                <NumericUpDown x:Name="SeedInput" Minimum="-1" Maximum="999999999" Value="-1"
                               Increment="1" FormatString="0" />

                <TextBlock x:Name="SpeedLabel" FontWeight="SemiBold" Margin="0,4,0,0" />
                <Slider x:Name="SpeedSlider" Minimum="20" Maximum="5000" Value="300" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="RegenerateButton" Content="Новый" />
                    <Button x:Name="PlayPauseButton" Content="Старт" MinWidth="100" Classes="accent" />
                    <Button x:Name="ResetButton" Content="Сброс" />
                </StackPanel>

                <Border Background="#1AFFFFFF" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ProgressText" Text="Шаг: 0 / 0" FontWeight="SemiBold" />
                        <TextBlock x:Name="CallsText" Text="Рекурсивных вызовов: 0" />
                        <TextBlock x:Name="DepthText" Text="Макс. глубина рекурсии: 0" />
                        <TextBlock x:Name="SeedText" Text="Seed: —" />
                        <TextBlock x:Name="TimeText" Text="Время расчёта: —" />
                        <TextBlock x:Name="StatusText" Text="" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Margin="0,12,0,0" CornerRadius="8" Background="#0F141A" ClipToBounds="True">
            <controls:MazeCanvas x:Name="Canvas" Margin="12" />
        </Border>
    </Grid>
</UserControl>