<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Algorithm_lab2.Controls"
             x:Class="Algorithm_lab2.Views.FloodFillView">
    <Grid ColumnDefinitions="300,*">
        <ScrollViewer>
            <StackPanel Margin="8,12,16,12" Spacing="10">
                <TextBlock Text="Рекурсивная заливка" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="Нажмите на клетку — запустится рекурсивная 4-связная заливка от этой точки."
                           TextWrapping="Wrap" Opacity="0.75" />

                <TextBlock Text="Размер сетки" FontWeight="SemiBold" Margin="0,8,0,0" />
                <NumericUpDown x:Name="GridSizeInput" Minimum="10" Maximum="60" Value="40"
                               Increment="5" FormatString="0" />
                <TextBlock x:Name="GridInfoText" Opacity="0.6" />

                <TextBlock x:Name="SpeedLabel" FontWeight="SemiBold" Margin="0,4,0,0" />
                <Slider x:Name="SpeedSlider" Minimum="50" Maximum="5000" Value="500" />

                <TextBlock x:Name="MaxCellsLabel" FontWeight="SemiBold" Margin="0,4,0,0" />
                <Slider x:Name="MaxCellsSlider" Minimum="10" Maximum="1600"
                        Value="1600" TickFrequency="1" IsSnapToTickEnabled="True" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="PlayPauseButton" Content="Пауза" MinWidth="110"
                            IsEnabled="False" Classes="accent" />
                    <Button x:Name="ClearButton" Content="Очистить" />
                </StackPanel>

                <Border Background="#1AFFFFFF" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ProgressText" Text="Готов к запуску" FontWeight="SemiBold" />
                        <TextBlock x:Name="CallsText" Text="Рекурсивных вызовов: 0" />
                        <TextBlock x:Name="MaxDepthText" Text="Макс. глубина рекурсии: 0" />
                        <TextBlock x:Name="TimeText" Text="Время расчёта: —" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Margin="0,12,0,0" CornerRadius="8" Background="#0F141A" ClipToBounds="True">
            <controls:FloodFillCanvas x:Name="Canvas" Margin="12" />
        </Border>
    </Grid>
</UserControl>