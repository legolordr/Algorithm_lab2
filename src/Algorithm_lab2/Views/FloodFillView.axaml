<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Algorithm_lab2.Controls"
             x:Class="Algorithm_lab2.Views.FloodFillView">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,*" Margin="24,20,24,24">
        <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,20">
            <TextBlock Classes="h1" Text="Рекурсивная заливка" />
            <TextBlock Classes="subtitle"
                       Text="Нажмите на клетку поля — от неё запустится 4-связная заливка: клетка закрашивается и вызывает заливку для четырёх соседей." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Margin="0,0,14,0">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="ПАРАМЕТРЫ" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Размер сетки" />
                            <NumericUpDown x:Name="GridSizeInput" Minimum="10" Maximum="60" Value="40"
                                           Increment="5" FormatString="0" AutomationProperties.Name="Размер сетки" />
                            <TextBlock x:Name="GridInfoText" Classes="hint" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <controls:StatRow x:Name="SpeedRow" Label="Скорость" />
                            <Slider x:Name="SpeedSlider" Minimum="50" Maximum="5000" Value="500"
                                    AutomationProperties.Name="Скорость" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <controls:StatRow x:Name="MaxCellsRow" Label="Максимум клеток" />
                            <Slider x:Name="MaxCellsSlider" Minimum="10" Maximum="1600"
                                    Value="1600" TickFrequency="1" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Максимум клеток" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Button x:Name="PlayPauseButton" Content="Пауза" Classes="accent wide" IsEnabled="False"
                                ToolTip.Tip="Пробел" />
                        <Button x:Name="ClearButton" Content="Очистить" Classes="wide" ToolTip.Tip="R" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="СОСТОЯНИЕ" />
                        <controls:StatRow x:Name="ProgressRow" Label="Закрашено" />
                        <ProgressBar x:Name="Progress" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="СТАТИСТИКА" />
                        <controls:StatRow x:Name="CallsStat" Label="Рекурсивных вызовов" />
                        <controls:StatRow x:Name="MaxDepthStat" Label="Макс. глубина рекурсии" />
                        <controls:StatRow x:Name="TimeStat" Label="Время расчёта" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Classes="canvas">
            <controls:FloodFillCanvas x:Name="Canvas" Margin="16" AutomationProperties.Name="Поле для заливки" />
        </Border>
    </Grid>
</UserControl>
