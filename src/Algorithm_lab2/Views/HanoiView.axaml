<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Algorithm_lab2.Controls"
             x:Class="Algorithm_lab2.Views.HanoiView">
    <Grid ColumnDefinitions="300,*">
        <Grid RowDefinitions="Auto,*" Margin="8,12,16,12">
            <StackPanel Spacing="10">
                <TextBlock Text="Количество дисков" FontWeight="SemiBold" />
                <NumericUpDown x:Name="DiskCount" Minimum="1" Maximum="12" Value="8" Increment="1"
                               FormatString="0" />

                <TextBlock Text="Алгоритм" FontWeight="SemiBold" Margin="0,4,0,0" />
                <RadioButton x:Name="RecursiveRadio" GroupName="Algorithm" Content="Рекурсия" IsChecked="True" />
                <RadioButton x:Name="StackRadio" GroupName="Algorithm" Content="Явный стек (без рекурсии)" />

                <TextBlock x:Name="DurationLabel" FontWeight="SemiBold" Margin="0,4,0,0" />
                <Slider x:Name="DurationSlider" Minimum="20" Maximum="1000" Value="300" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PlayButton" Content="Старт" MinWidth="80" Classes="accent" />
                    <Button x:Name="StepButton" Content="Шаг" />
                    <Button x:Name="ResetButton" Content="Сброс" />
                </StackPanel>

                <Border Background="#1AFFFFFF" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ProgressText" FontWeight="SemiBold" />
                        <TextBlock x:Name="MinMovesText" />
                        <TextBlock x:Name="DepthText" />
                        <TextBlock x:Name="StatusText" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Ходы" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>

            <ListBox Grid.Row="1" x:Name="MovesList" Margin="0,8,0,0" />
        </Grid>

        <Border Grid.Column="1" Margin="0,12,0,0" CornerRadius="8" Background="#0F141A" ClipToBounds="True">
            <controls:HanoiBoard x:Name="Board" Margin="12" />
        </Border>
    </Grid>
</UserControl>
