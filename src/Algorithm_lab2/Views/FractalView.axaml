<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Algorithm_lab2.Controls"
             x:Class="Algorithm_lab2.Views.FractalView">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,*" Margin="24,20,24,24">
        <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,20">
            <TextBlock Classes="h1" Text="Фракталы" />
            <TextBlock Classes="subtitle"
                       Text="Фигура строится рекурсивно: каждый вызов рисует часть фигуры и вызывает себя для частей поменьше, пока не дойдёт до глубины 0." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Margin="0,0,14,0">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="ПАРАМЕТРЫ" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Фрактал" />
                            <ListBox x:Name="FractalList" AutomationProperties.Name="Фрактал" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Режим" />
                            <RadioButton x:Name="FinishedRadio" GroupName="FractalMode" Content="Готовая фигура"
                                         IsChecked="True" />
                            <RadioButton x:Name="StepRadio" GroupName="FractalMode" Content="Пошаговое построение" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <controls:StatRow x:Name="DepthRow" Label="Глубина рекурсии" />
                            <Slider x:Name="DepthSlider" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Глубина рекурсии" />
                        </StackPanel>
                        <StackPanel x:Name="SpeedPanel" Spacing="2" IsVisible="False">
                            <controls:StatRow x:Name="SpeedRow" Label="Скорость" />
                            <Slider x:Name="SpeedSlider" Minimum="1" Maximum="20" Value="2"
                                    AutomationProperties.Name="Скорость" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step-by-step mode: one recursive split per step. -->
                <StackPanel x:Name="StepPanel" Spacing="12" IsVisible="False">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <Button x:Name="PlayButton" Content="Старт" Classes="accent wide" ToolTip.Tip="Пробел" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="StepButton" Content="Шаг" Classes="wide" ToolTip.Tip="→" />
                                <Button Grid.Column="1" x:Name="ResetButton" Content="Сначала" Classes="wide"
                                        ToolTip.Tip="R" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="СОСТОЯНИЕ" />
                            <controls:StatRow x:Name="ProgressRow" Label="Делений отрезка" />
                            <ProgressBar x:Name="Progress" />
                            <controls:StatRow x:Name="SegmentsNowRow" Label="Отрезков сейчас" />
                            <controls:StatRow x:Name="LevelRow" Label="Уровень рекурсии" />
                            <TextBlock x:Name="StepText" Classes="status" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="ОБОЗНАЧЕНИЯ" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="swatch" Background="{DynamicResource VizCompareBrush}" />
                                <TextBlock Classes="hint" Text="отрезок, который делим на 3 части" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="swatch" Background="{DynamicResource VizWriteBrush}" />
                                <TextBlock Classes="hint" Text="две новые стороны зубца" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="DescriptionCard" Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="КАК СТРОИТСЯ" />
                        <TextBlock x:Name="DescriptionText" Classes="status" />
                    </StackPanel>
                </Border>

                <Border x:Name="StatsCard" Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="СТАТИСТИКА" />
                        <controls:StatRow x:Name="CallsStat" Label="Рекурсивных вызовов" />
                        <controls:StatRow x:Name="SegmentsStat" Label="Отрезков" />
                        <controls:StatRow x:Name="TimeStat" Label="Время расчёта" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Classes="canvas">
            <Panel Margin="16">
                <controls:FractalCanvas x:Name="Canvas" AutomationProperties.Name="Изображение фрактала" />
                <controls:KochStepCanvas x:Name="StepCanvas" IsVisible="False"
                                         AutomationProperties.Name="Пошаговое построение снежинки Коха" />
            </Panel>
        </Border>
    </Grid>
</UserControl>
