<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Algorithm_lab2.Controls"
             x:Class="Algorithm_lab2.Views.FractalView">
    <Grid ColumnDefinitions="300,*">
        <ScrollViewer>
            <StackPanel Margin="8,12,16,12" Spacing="10">
                <TextBlock Text="Фрактал" FontWeight="SemiBold" FontSize="16" />
                <ListBox x:Name="FractalList" />

                <TextBlock x:Name="DepthLabel" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Slider x:Name="DepthSlider" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True" />

                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Opacity="0.8" />

                <Border Background="#1AFFFFFF" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="CallsText" />
                        <TextBlock x:Name="ShapesText" />
                        <TextBlock x:Name="TimeText" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Margin="0,12,0,0" CornerRadius="8" Background="#0F141A" ClipToBounds="True">
            <controls:FractalCanvas x:Name="Canvas" Margin="12" />
        </Border>
    </Grid>
</UserControl>
