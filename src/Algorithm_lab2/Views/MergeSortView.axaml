<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Algorithm_lab2.Controls"
             x:Class="Algorithm_lab2.Views.MergeSortView">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,*" Margin="24,20,24,24">
        <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,20">
            <TextBlock Classes="h1" Text="Сортировка слиянием" />
            <TextBlock Classes="subtitle"
                       Text="Массив делится пополам, каждая половина сортируется рекурсивно, затем две отсортированные половины сливаются в одну. Каждый блок дерева — один вызов на своей глубине." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Margin="0,0,14,0">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="section" Text="ПАРАМЕТРЫ" />
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Размер массива" />
                            <NumericUpDown x:Name="SizeInput" Minimum="2" Maximum="16" Value="8" Increment="1"
                                           FormatString="0" AutomationProperties.Name="Размер массива" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Исходные данные" />
                            <ComboBox x:Name="OrderInput" SelectedIndex="0" AutomationProperties.Name="Исходные данные">
                                <ComboBoxItem Content="Случайный порядок" />
                                <ComboBoxItem Content="Обратный порядок" />
                                <ComboBoxItem Content="Почти отсортирован" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <controls:StatRow x:Name="SpeedRow" Label="Скорость" />
                            <Slider x:Name="SpeedSlider" Minimum="1" Maximum="30" Value="3"
                                    AutomationProperties.Name="Скорость" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Button x:Name="PlayButton" Content="Старт" Classes="accent wide" ToolTip.Tip="Пробел" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="StepButton" Content="Шаг" Classes="wide" ToolTip.Tip="→" />
                            <Button Grid.Column="1" x:Name="ResetButton" Content="Сначала" Classes="wide"
                                    ToolTip.Tip="R" />
                        </Grid>
                        <Button x:Name="ShuffleButton" Content="Новый массив" Classes="wide" ToolTip.Tip="N" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="СОСТОЯНИЕ" />
                        <controls:StatRow x:Name="ProgressRow" Label="Шаг" />
                        <ProgressBar x:Name="Progress" />
                        <TextBlock x:Name="CurrentText" Classes="status" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="СТАТИСТИКА" />
                        <controls:StatRow x:Name="CallsStat" Label="Рекурсивных вызовов" />
                        <controls:StatRow x:Name="DepthStat" Label="Макс. глубина рекурсии" />
                        <controls:StatRow x:Name="ComparisonsStat" Label="Сравнений" />
                        <controls:StatRow x:Name="WritesStat" Label="Записей" />
                        <controls:StatRow x:Name="TimeStat" Label="Время расчёта" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="ОБОЗНАЧЕНИЯ" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="swatch" BorderBrush="{DynamicResource VizActiveBrush}" BorderThickness="2" />
                            <TextBlock Classes="hint" Text="текущий вызов" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="swatch" BorderBrush="{DynamicResource VizActiveBrush}" BorderThickness="1"
                                    Opacity="0.6" />
                            <TextBlock Classes="hint" Text="ждёт в стеке вызовов" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="swatch" Background="{DynamicResource VizCompareBrush}" />
                            <TextBlock Classes="hint" Text="сравниваемая пара" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="swatch" Background="{DynamicResource VizWriteBrush}" />
                            <TextBlock Classes="hint" Text="элемент перенесён в результат" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="swatch" Background="{DynamicResource VizDoneSurfaceBrush}"
                                    BorderBrush="{DynamicResource VizDoneBrush}" BorderThickness="1" />
                            <TextBlock Classes="hint" Text="отсортированный отрезок" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Classes="canvas">
            <controls:MergeTreeCanvas x:Name="Tree" Margin="20" AutomationProperties.Name="Дерево рекурсивных вызовов" />
        </Border>
    </Grid>
</UserControl>
